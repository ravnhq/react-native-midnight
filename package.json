{
  "name": "react-native-midnight",
  "version": "0.0.0",
  "description": "Subscribe to changes in time",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "react-native-midnight.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier .",
    "format:check": "yarn format --check",
    "validate": "npm-run-all typescript lint format:check",
    "build": "bob build",
    "prepublishOnly": "yarn build",
    "release": "yarn semantic-release",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "midnight",
    "day-changed",
    "calendardaychanged",
    "time-changed",
    "date-changed",
    "timezone-changed"
  ],
  "repository": "https://github.com/ravnhq/react-native-midnight",
  "author": "https://www.ravn.co/",
  "license": "MIT",
  "bugs": {
    "url": "https://www.github.com/ravnhq/react-native-midnight/issues"
  },
  "homepage": "https://www.github.com/ravnhq/react-native-midnight#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@ravnhq/eslint-config": "^2.0.0",
    "@ravnhq/prettier-config": "^1.1.0",
    "@release-it/conventional-changelog": "^6.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.12",
    "@types/react-native": "0.66.28",
    "eslint": "^8.0.0",
    "husky": "^4.2.5",
    "jest": "^29.6.3",
    "lint-staged": "^15.2.2",
    "npm-run-all": "^4.1.5",
    "pod-install": "^0.1.39",
    "prettier": "^2.8.8",
    "react": "18.2.0",
    "react-native": "0.73.8",
    "react-native-builder-bob": "^0.20.4",
    "semantic-release": "^20.1.3",
    "typescript": "^5.0.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
